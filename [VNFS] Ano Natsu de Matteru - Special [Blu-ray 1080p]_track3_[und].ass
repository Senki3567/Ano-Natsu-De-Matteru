Dialogue: 0,0:00:16.07,0:00:18.50,Default 11,,0,0,0,,Kai-kun.
Dialogue: 0,0:00:20.17,0:00:23.73,Default 11,,0,0,0,,Mau dậy đi! Trễ rồi kìa!
Dialogue: 0,0:00:26.79,0:00:28.51,Default 11,,0,0,0,,Kai-kun!
Dialogue: 0,0:00:28.90,0:00:30.55,Default 11,,0,0,0,,Dậy rồi đây!
Dialogue: 0,0:00:36.64,0:00:41.92,Default 11,,0,0,0,,Nè, Kai-kun, sau này em định làm gì?
Dialogue: 0,0:00:43.55,0:00:47.19,Default 11,,0,0,0,,Để em suy nghĩ thêm đã.
Dialogue: 0,0:00:47.68,0:00:51.54,Default 11,,0,0,0,,Nếu là về tiền nong thì em không phải lo đâu.
Dialogue: 0,0:00:51.62,0:00:55.79,Default 11,,0,0,0,,Cứ làm những gì em muốn.
Dialogue: 0,0:00:57.28,0:01:00.29,Default 11,,0,0,0,,Cám ơn chị.
Dialogue: 0,0:01:01.39,0:01:02.49,Default 11,,0,0,0,,Còn bây giờ...
Dialogue: 0,0:01:02.82,0:01:04.49,Default 11,,0,0,0,,Ra làm lễ thôi!
Dialogue: 0,0:01:13.63,0:01:16.43,Default 11,,0,0,0,,Thôi, chắc hôm nay chị sẽ về trễ.
Dialogue: 0,0:01:16.43,0:01:18.78,Default 11,,0,0,0,,Cứ ăn tối trước đi nhé.
Dialogue: 0,0:01:18.78,0:01:20.19,Default 11,,0,0,0,,Rồi, rồi.
Dialogue: 0,0:01:21.81,0:01:24.93,Default 11,,0,0,0,,Đây là kì nghỉ hè cuối cùng của em rồi nhỉ?
Dialogue: 0,0:01:26.34,0:01:29.90,Default 11,,0,0,0,,Cứ cố gắng hết mình đi.
Dialogue: 0,0:01:29.90,0:01:31.86,Default 11,,0,0,0,,Thôi, chị đi đây.
Dialogue: 0,0:01:31.86,0:01:33.66,Default 11,,0,0,0,,Vâng, chị đi cẩn thận.
Dialogue: 0,0:01:33.66,0:01:36.05,Default 11,,0,0,0,,Em cũng thế nhé!
Dialogue: 0,0:02:14.36,0:02:17.25,Default 11,,0,0,0,,Kì nghỉ hè cuối cùng à?
Dialogue: 0,0:05:13.97,0:05:16.36,Default 11,,0,0,0,,
Dialogue: 0,0:05:39.73,0:05:43.45,Default 11,,0,0,0,,Biến... thái quá...
Dialogue: 0,0:05:43.78,0:05:45.74,Default 11,,0,0,0,,Gì hả?
Dialogue: 0,0:05:46.13,0:05:51.83,Default 11,,0,0,0,,Tớ nghĩ cậu học hè chắc vất vả lắm nên đem cái này tới.
Dialogue: 0,0:05:51.83,0:05:55.69,Default 11,,0,0,0,,Nhưng chắc không cần nữa rồi.
Dialogue: 0,0:05:55.69,0:05:57.69,Default 11,,0,0,0,,Đang giờ giải lao thôi.
Dialogue: 0,0:05:58.49,0:06:01.95,Default 11,,0,0,0,,Ra thế... Giờ tự sướng à.
Dialogue: 0,0:06:01.95,0:06:03.68,Default 11,,0,0,0,,Tính làm ông già đấy à?
Dialogue: 0,0:06:13.45,0:06:15.86,Default 11,,0,0,0,,Thế, hôm nay là gì?
Dialogue: 0,0:06:15.86,0:06:20.07,Default 11,,0,0,0,,Kanna bảo tớ đến kiểm tra cậu.
Dialogue: 0,0:06:21.64,0:06:24.46,Default 11,,0,0,0,,Gì chứ? Chả tin tưởng nhau tí nào.
Dialogue: 0,0:06:24.46,0:06:27.28,Default 11,,0,0,0,,Vậy thì chú tâm vào việc học đi.
Dialogue: 0,0:06:27.28,0:06:29.49,Default 11,,0,0,0,,Nếu không hiểu gì thì cứ hỏi.
Dialogue: 0,0:06:29.49,0:06:30.86,Default 11,,0,0,0,,Tớ giảng cho.
Dialogue: 0,0:06:30.88,0:06:33.86,Default 11,,0,0,0,,Không cần cậu phải giảng đâu.
Dialogue: 0,0:06:34.56,0:06:35.72,Default 11,,0,0,0,,Cơ mà cậu đang làm gì thế?
Dialogue: 0,0:06:35.72,0:06:41.55,Default 11,,0,0,0,,À, tớ định làm ở nhà mà chị ấy ồn ào quá.
Dialogue: 0,0:06:41.55,0:06:43.47,Default 11,,0,0,0,,Chị Manami lại về nhà à?
Dialogue: 0,0:06:43.47,0:06:45.84,Default 11,,0,0,0,,Ờ... Bà chị phiền phức đó...
Dialogue: 0,0:06:46.27,0:06:47.97,Default 11,,0,0,0,,Vẫn say bí tỉ.
Dialogue: 0,0:06:47.97,0:06:50.31,Default 11,,0,0,0,,Satoshi ngốc...
Dialogue: 0,0:06:52.20,0:06:53.89,Default 11,,0,0,0,,Chồng chị ấy lại bận à?
Dialogue: 0,0:06:53.95,0:06:54.99,Default 11,,0,0,0,,Ai biết.
Dialogue: 0,0:06:54.99,0:07:00.49,Default 11,,0,0,0,,Alien là vấn đề tuyệt mật... Tớ có hỏi thế nào anh ấy cũng không nói.
Dialogue: 0,0:07:02.58,0:07:03.99,Default 11,,0,0,0,,Chắc thế.
Dialogue: 0,0:07:08.46,0:07:09.91,Default 11,,0,0,0,,Còn Kitahara?
Dialogue: 0,0:07:10.08,0:07:13.98,Default 11,,0,0,0,,À, hôm nay cô ấy đến nhà Kanna.
Dialogue: 0,0:07:13.98,0:07:17.66,Default 11,,0,0,0,,Hai bà tám với ở nhau à?
Dialogue: 0,0:07:17.66,0:07:20.99,Default 11,,0,0,0,,Mà chắc tớ cũng đoán được họ nói về chuyện gì.
Dialogue: 0,0:07:20.99,0:07:21.74,Default 11,,0,0,0,,Chuyện gì?
Dialogue: 0,0:07:22.58,0:07:24.56,Default 11,,0,0,0,,Về tớ.
Dialogue: 0,0:07:24.85,0:07:28.59,Default 11,,0,0,0,,Hả!? Thư tình trong cặp Tetsurou?
Dialogue: 0,0:07:28.59,0:07:30.26,Default 11,,0,0,0,,Tận ba bức lận.
Dialogue: 0,0:07:30.26,0:07:34.05,Default 11,,0,0,0,,Tớ đã bảo cậu ấy giao nộp hết số thư đó.
Dialogue: 0,0:07:34.05,0:07:36.95,Default 11,,0,0,0,,Tetsurou ưa nhìn thế mà.
Dialogue: 0,0:07:36.95,0:07:39.40,Default 11,,0,0,0,,Thế mấy bức thư sao rồi?
Dialogue: 0,0:07:39.52,0:07:41.95,Default 11,,0,0,0,,Tớ xé hết ngay tại đó rồi.
Dialogue: 0,0:07:41.95,0:07:44.02,Default 11,,0,0,0,,Thế thì ác quá, Mio.
Dialogue: 0,0:07:44.02,0:07:45.86,Default 11,,0,0,0,,Nếu không làm thế,
Dialogue: 0,0:07:45.86,0:07:47.86,Default 11,,0,0,0,,Cậu ấy sẽ không thông được!
Dialogue: 0,0:07:48.04,0:07:49.43,Default 11,,0,0,0,,Thế à...
Dialogue: 0,0:07:49.43,0:07:51.15,Default 11,,0,0,0,,Tecchan lúc nào cũng thế.
Dialogue: 0,0:07:51.23,0:07:53.95,Default 11,,0,0,0,,Chỉ vì suy nghĩ quá nhiều nên cậu ấy chả bao giờ nói ra cảm xúc của mình.
Dialogue: 0,0:07:53.95,0:07:56.20,Default 11,,0,0,0,,À... này, Mio...
Dialogue: 0,0:07:57.18,0:08:01.96,Default 11,,0,0,0,,Mio! Bánh chín rồi kìa!
Dialogue: 0,0:08:02.31,0:08:05.13,Default 11,,0,0,0,,Tớ nghĩ mình cũng hiểu được cảm xúc của Kitahara.
Dialogue: 0,0:08:05.80,0:08:08.81,Default 11,,0,0,0,,Ai cũng biết cậu đang hẹn hò với cô ấy mà.
Dialogue: 0,0:08:08.81,0:08:14.20,Default 11,,0,0,0,,N-Nhưng mà... cô ấy làm thế tớ xấu hổ lắm...
Dialogue: 0,0:08:14.55,0:08:17.04,Default 11,,0,0,0,,Cậu nói gì thế, hai người là một đôi rồi mà.
Dialogue: 0,0:08:17.74,0:08:20.02,Default 11,,0,0,0,,Ê, đừng có xả rác.
Dialogue: 0,0:08:20.11,0:08:23.27,Default 11,,0,0,0,,Tại nãy giờ cậu nói toàn thứ kì quặc đấy!
Dialogue: 0,0:08:23.52,0:08:25.72,Default 11,,0,0,0,,Kì quặc à? Kì quặc chỗ nào?
Dialogue: 0,0:08:26.03,0:08:27.93,Default 11,,0,0,0,,Cậu có ý kiến gì không?
Dialogue: 0,0:08:27.93,0:08:30.24,Default 11,,0,0,0,,Giọng điệu như mấy ông già.
Dialogue: 0,0:08:31.30,0:08:32.94,Default 11,,0,0,0,,Đây rồi.
Dialogue: 0,0:08:33.33,0:08:34.43,Default 11,,0,0,0,,Ủa?
Dialogue: 0,0:08:34.51,0:08:35.72,Default 11,,0,0,0,,Gì thế?
Dialogue: 0,0:08:35.88,0:08:38.97,Default 11,,0,0,0,,À, tớ thấy cái này dưới nệm.
Dialogue: 0,0:08:39.36,0:08:40.30,Default 11,,0,0,0,,Cuộn phim?
Dialogue: 0,0:08:40.38,0:08:41.17,Default 11,,0,0,0,,Ờ.
Dialogue: 0,0:08:41.73,0:08:43.99,Default 11,,0,0,0,,Sao nó lại ở đây?
Dialogue: 0,0:08:46.22,0:08:47.37,Default 11,,0,0,0,,Nhắc mới nhớ,
Dialogue: 0,0:08:47.53,0:08:50.76,Default 11,,0,0,0,,Trước đây tớ từng quay thử một bộ phim...
Dialogue: 0,0:08:51.13,0:08:51.58,Default 11,,0,0,0,,
Dialogue: 0,0:08:53.05,0:08:55.07,Default 11,,0,0,0,,Bộ phim này quay khi nào?
Dialogue: 0,0:08:57.03,0:09:00.91,Default 11,,0,0,0,,Không phải bộ phim bọn mình quay đây sao?
Dialogue: 0,0:09:08.68,0:09:10.68,Default 11,,0,0,0,,Thật là...
Dialogue: 0,0:09:11.31,0:09:13.11,Default 11,,0,0,0,,Tetsurou ngốc,
Dialogue: 0,0:09:13.11,0:09:15.67,Default 11,,0,0,0,,Cậu liệu mà thanh minh.
Dialogue: 0,0:09:15.67,0:09:18.30,Default 11,,0,0,0,,Dám làm Mio phải lo lắng như thế.
Dialogue: 0,0:09:22.39,0:09:23.78,Default 11,,0,0,0,,Thiệt tình.
Dialogue: 0,0:09:24.78,0:09:26.72,Default 11,,0,0,0,,Tớ nói rồi...
Dialogue: 0,0:09:26.83,0:09:29.58,Default 11,,0,0,0,,Mình cũng muốn chết.
Dialogue: 0,0:09:30.73,0:09:35.84,Default 11,,0,0,0,,K-Không. Nói rồi, đó không phải thư tình.
Dialogue: 0,0:09:36.12,0:09:39.43,Default 11,,0,0,0,,Chỉ là thư của fan, hoặc đại loại thôi...
Dialogue: 0,0:09:39.66,0:09:44.58,Default 11,,0,0,0,,Ồ, thế à? Cậu cũng nổi tiếng quá nhỉ?
Dialogue: 0,0:09:44.58,0:09:46.97,Default 11,,0,0,0,,Vui vẻ lên xem nào.
Dialogue: 0,0:09:48.22,0:09:49.71,Default 11,,0,0,0,,Vậy...
Dialogue: 0,0:09:51.76,0:09:53.51,Default 11,,0,0,0,,Nói "tớ yêu cậu" đi.
Dialogue: 0,0:09:57.78,0:09:58.99,Default 11,,0,0,0,,Thế là sao?
Dialogue: 0,0:09:58.99,0:10:00.13,Default 11,,0,0,0,,Nói đi!
Dialogue: 0,0:10:00.38,0:10:01.46,Default 11,,0,0,0,,Nhưng...
Dialogue: 0,0:10:01.46,0:10:03.30,Default 11,,0,0,0,,Mau nói đi!
Dialogue: 0,0:10:05.75,0:10:09.57,Default 11,,0,0,0,,T-Tơ yêu câu...
Dialogue: 0,0:10:09.57,0:10:11.25,Default 11,,0,0,0,,Nói rõ lên!
Dialogue: 0,0:10:12.37,0:10:14.30,Default 11,,0,0,0,,Thoải mái quá...
Dialogue: 0,0:10:14.30,0:10:17.16,Default 11,,0,0,0,,Không, tớ cũng thế mà.
Dialogue: 0,0:10:18.99,0:10:21.35,Default 11,,0,0,0,,Hả? Làm gì có.
Dialogue: 0,0:10:21.35,0:10:23.39,Default 11,,0,0,0,,Có vẻ cậu ấy khá hơn rồi.
Dialogue: 0,0:10:23.39,0:10:24.57,Default 11,,0,0,0,,Tớ biết mà.
Dialogue: 0,0:10:25.15,0:10:27.11,Default 11,,0,0,0,,Thế là tốt rồi.
Dialogue: 0,0:10:28.60,0:10:31.95,Default 11,,0,0,0,,Hả, cuộn phim 8mm? Cậu tìm thấy
Dialogue: 0,0:10:28.60,0:10:30.60,Default 11,,0,0,0,,
Dialogue: 0,0:10:32.58,0:10:34.51,Default 11,,0,0,0,,ở nhà Kirishima ư?
Dialogue: 0,0:10:34.51,0:10:36.00,Default 11,,0,0,0,,Cái gì 8mm?
Dialogue: 0,0:10:36.57,0:10:37.61,Default 11,,0,0,0,,Kanna!
Dialogue: 0,0:10:37.61,0:10:38.71,Default 11,,0,0,0,,Phim gì cơ?
Dialogue: 0,0:10:38.71,0:10:40.84,Default 11,,0,0,0,,Ồ, Kanna à? Không...
Dialogue: 0,0:10:40.84,0:10:42.70,Default 11,,0,0,0,,Tớ nhặt được ở đó.
Dialogue: 0,0:10:42.90,0:10:46.85,Default 11,,0,0,0,,Cậu còn nhớ bọn mình từng quay thử ở nhà Kai không?
Dialogue: 0,0:10:46.85,0:10:48.93,Default 11,,0,0,0,,Đêm đó còn đốt pháo hoa nữa.
Dialogue: 0,0:10:49.07,0:10:51.98,Default 11,,0,0,0,,À, nhắc mới nhớ.
Dialogue: 0,0:10:51.98,0:10:54.04,Default 11,,0,0,0,,Nhưng sao cậu lại nói chuyện này?
Dialogue: 0,0:10:54.04,0:10:58.17,Default 11,,0,0,0,,À, tại lúc dọn dẹp đồ đạc thì còn.
Dialogue: 0,0:10:58.45,0:11:02.64,Default 11,,0,0,0,,Nhưng sau đó hình như do cậu ấy quên cất nó đi.
Dialogue: 0,0:11:04.14,0:11:05.97,Default 11,,0,0,0,,Thế à...
Dialogue: 0,0:11:06.65,0:11:07.88,Default 11,,0,0,0,,Kanna?
Dialogue: 0,0:11:09.29,0:11:13.17,Default 11,,0,0,0,,Đến giờ... Kaito vẫn...
Dialogue: 0,0:11:15.15,0:11:16.93,Default 11,,0,0,0,,Nè, Mio.
Dialogue: 0,0:11:25.51,0:11:27.19,Default 11,,0,0,0,,Kai-kun.
Dialogue: 0,0:11:27.37,0:11:30.17,Default 11,,0,0,0,,Chị đi ngủ đây, mai còn phải dậy sớm nữa.
Dialogue: 0,0:11:31.52,0:11:32.48,Default 11,,0,0,0,,Chị ngủ ngon.
Dialogue: 0,0:11:32.76,0:11:34.24,Default 11,,0,0,0,,Cũng lâu rồi nhỉ?
Dialogue: 0,0:11:36.50,0:11:37.40,Default 11,,0,0,0,,Không có gì.
Dialogue: 0,0:11:37.93,0:11:40.06,Default 11,,0,0,0,,Em tìm thấy cuộn phim cũ.
Dialogue: 0,0:11:40.57,0:11:42.94,Default 11,,0,0,0,,Muốn hồi tưởng lại một tí.
Dialogue: 0,0:11:45.99,0:11:46.97,Default 11,,0,0,0,,Ừ.
Dialogue: 0,0:11:47.95,0:11:51.91,Default 11,,0,0,0,,Thôi, mai chị không thức em dậy đâu, ngủ ngon.
Dialogue: 0,0:11:52.22,0:11:53.08,Default 11,,0,0,0,,Chị ngủ ngon.
Dialogue: 0,0:12:20.54,0:12:22.34,Default 11,,0,0,0,,Hả, gì cơ?
Dialogue: 0,0:12:22.44,0:12:24.26,Default 11,,0,0,0,,E-Em quay rồi à?
Dialogue: 0,0:12:24.48,0:12:26.67,Default 11,,0,0,0,,Không cần phải hồi hộp vậy đâu.
Dialogue: 0,0:12:26.84,0:12:28.33,Default 11,,0,0,0,,Cứ bình tĩnh.
Dialogue: 0,0:12:28.47,0:12:32.54,Default 11,,0,0,0,,Nhưng chị vẫn thấy ngại lắm.
Dialogue: 0,0:12:32.95,0:12:35.11,Default 11,,0,0,0,,Chị đừng lo.
Dialogue: 0,0:12:35.29,0:12:38.20,Default 11,,0,0,0,,Chỉ là quay thử thôi mà, không làm thật đâu.
Dialogue: 0,0:12:38.67,0:12:40.24,Default 11,,0,0,0,,Cứ thư giãn.
Dialogue: 0,0:12:40.44,0:12:42.90,Default 11,,0,0,0,,N-Nói thì dễ...
Dialogue: 0,0:12:43.18,0:12:46.15,Default 11,,0,0,0,,Kai, ánh sáng thế này đã được chưa?
Dialogue: 0,0:12:46.15,0:12:47.07,Default 11,,0,0,0,,Chị Ichika!
Dialogue: 0,0:12:47.07,0:12:49.07,Default 11,,0,0,0,,Tetsurou! Sao lại rọi vào chị ấy?
Dialogue: 0,0:12:50.91,0:12:52.03,Default 11,,0,0,0,,Bắt đầu nhé.
Dialogue: 0,0:12:52.64,0:12:54.26,Default 11,,0,0,0,,Chuẩn bị... Diễn!
Dialogue: 0,0:12:54.91,0:12:56.10,Default 11,,0,0,0,,
Dialogue: 0,0:12:56.38,0:12:59.47,Default 11,,0,0,0,,Chị cứ đi như bình thường thôi.
Dialogue: 0,0:13:04.46,0:13:08.89,Default 11,,0,0,0,,Chị... vừa đi vừa ngắm cảnh vật xem.
Dialogue: 0,0:13:11.22,0:13:14.24,Default 11,,0,0,0,,Tay chân chị ấy cứ như máy ấy.
Dialogue: 0,0:13:14.24,0:13:15.37,Default 11,,0,0,0,,Phim như này...
Dialogue: 0,0:13:15.53,0:13:17.02,Default 11,,0,0,0,,Liệu có ổn không?
Dialogue: 0,0:13:18.88,0:13:20.62,Default 11,,0,0,0,,Được rồi, tốt lắm.
Dialogue: 0,0:13:23.21,0:13:25.79,Default 11,,0,0,0,,Bây giờ em sẽ lấy khung cảnh ở trong phòng.
Dialogue: 0,0:13:25.79,0:13:28.38,Default 11,,0,0,0,,Phiền chị diễn lại như vừa nãy nhé.
Dialogue: 0,0:13:28.38,0:13:29.63,Default 11,,0,0,0,,Hả!?
Dialogue: 0,0:14:00.71,0:14:02.22,Default 11,,0,0,0,,Được rồi.
Dialogue: 0,0:14:04.37,0:14:05.58,Default 11,,0,0,0,,Chị vất vả rồi.
Dialogue: 0,0:14:05.74,0:14:07.35,Default 11,,0,0,0,,Mệt quá đi.
Dialogue: 0,0:14:07.86,0:14:08.56,Default 11,,0,0,0,,Kanna,
Dialogue: 0,0:14:08.72,0:14:10.56,Default 11,,0,0,0,,Hôm nay quay được bao nhiêu rồi?
Dialogue: 0,0:14:10.73,0:14:12.05,Default 11,,0,0,0,,Để xem...
Dialogue: 0,0:14:12.48,0:14:14.47,Default 11,,0,0,0,,Được một nửa rồi.
Dialogue: 0,0:14:15.12,0:14:17.94,Default 11,,0,0,0,,Đoạn thứ ba cũng dài lắm đấy.
Dialogue: 0,0:14:18.16,0:14:19.57,Default 11,,0,0,0,,Nè, Kai.
Dialogue: 0,0:14:19.57,0:14:20.74,Default 11,,0,0,0,,Cậu chắc chứ?
Dialogue: 0,0:14:20.74,0:14:21.72,Default 11,,0,0,0,,Về cái gì?
Dialogue: 0,0:14:21.90,0:14:23.89,Default 11,,0,0,0,,Diễn xuất của chị Ichika.
Dialogue: 0,0:14:24.03,0:14:26.11,Default 11,,0,0,0,,Chị ấy diễn dở ẹc.
Dialogue: 0,0:14:26.15,0:14:29.48,Default 11,,0,0,0,,Ờ thì, lần đầu như vậy là được rồi.
Dialogue: 0,0:14:29.75,0:14:32.06,Default 11,,0,0,0,,Chắc phải sớm tìm nữ chính khác thôi.
Dialogue: 0,0:14:32.94,0:14:35.62,Default 11,,0,0,0,,À ừ, cứ đợi xem đã.
Dialogue: 0,0:14:36.49,0:14:39.70,Default 11,,0,0,0,, Phù... Diễn tự nhiên khó quá.
Dialogue: 0,0:14:40.85,0:14:43.16,Default 11,,0,0,0,,Căng thẳng nên giờ khát quá.
Dialogue: 0,0:14:43.34,0:14:44.20,Default 11,,0,0,0,,Xin mời.
Dialogue: 0,0:14:44.30,0:14:46.24,Default 11,,0,0,0,,A, cám ơn.
Dialogue: 0,0:14:50.68,0:14:54.05,Default 11,,0,0,0,,Nước chanh này ngon quá.
Dialogue: 0,0:14:54.54,0:14:56.64,Default 11,,0,0,0,,Cơ mà... Remon!?
Dialogue: 0,0:14:56.97,0:14:58.97,Default 11,,0,0,0,,Còn nhiều lắm.
Dialogue: 0,0:14:59.24,0:15:00.65,Default 11,,0,0,0,,Chị Remon!
Dialogue: 0,0:15:00.85,0:15:03.47,Default 11,,0,0,0,,Lúc nào cũng xuất hiện như ma.
Dialogue: 0,0:15:03.47,0:15:04.55,Default 11,,0,0,0,,
Dialogue: 0,0:15:04.73,0:15:05.55,Default 11,,0,0,0,,Chị Remon.
Dialogue: 0,0:15:05.84,0:15:07.62,Default 11,,0,0,0,,Chị đã viết xong kịch bản chưa?
Dialogue: 0,0:15:10.15,0:15:12.32,Default 11,,0,0,0,,Chắc chưa nhỉ?
Dialogue: 0,0:15:12.52,0:15:14.69,Default 11,,0,0,0,,Để viết được một kịch bản hay,
Dialogue: 0,0:15:14.69,0:15:19.84,Default 11,,0,0,0,,Chị nghĩ nên quan sát nữ chính của chúng ta - Ichika, để tìm nguồn cảm hứng.
Dialogue: 0,0:15:20.12,0:15:22.15,Default 11,,0,0,0,,Đúng là vẫn chưa viết xong.
Dialogue: 0,0:15:22.25,0:15:25.50,Default 11,,0,0,0,,Nói là thế, nhưng nhìn diễn xuất của chị Ichika mà xem...
Dialogue: 0,0:15:25.50,0:15:26.54,Default 11,,0,0,0,,Gì cơ?
Dialogue: 0,0:15:28.34,0:15:32.53,Default 11,,0,0,0,,Chị... làm sao cơ?
Dialogue: 0,0:15:32.96,0:15:34.53,Default 11,,0,0,0,,À... Không...
Dialogue: 0,0:15:34.86,0:15:36.65,Default 11,,0,0,0,,Không có gì đâu ạ.
Dialogue: 0,0:15:36.88,0:15:38.41,Default 11,,0,0,0,,Thế là sao?
Dialogue: 0,0:15:38.72,0:15:40.84,Default 11,,0,0,0,,Lạ quá đi.
Dialogue: 0,0:15:41.03,0:15:42.72,Default 11,,0,0,0,,Khiêu gợi quá!
Dialogue: 0,0:15:42.76,0:15:46.20,Default 11,,0,0,0,,Chị ấy chỉ hơn bọn mình 2 tuổi, nhưng sao lại khác biệt thế này?
Dialogue: 0,0:15:46.71,0:15:48.36,Default 11,,0,0,0,,Kai, máy quay!
Dialogue: 0,0:15:49.65,0:15:51.82,Default 11,,0,0,0,, Hả... gì cơ?
Dialogue: 0,0:15:52.02,0:15:53.90,Default 11,,0,0,0,,Em vẫn đang quay à?
Dialogue: 0,0:15:54.57,0:15:56.17,Default 11,,0,0,0,,Kì quá.
Dialogue: 0,0:15:58.76,0:16:00.71,Default 11,,0,0,0,,Trời nóng quá.
Dialogue: 0,0:16:02.10,0:16:04.38,Default 11,,0,0,0,,Người mình bừng cả lên.
Dialogue: 0,0:16:06.08,0:16:07.80,Default 11,,0,0,0,,Sao thế?
Dialogue: 0,0:16:08.41,0:16:10.68,Default 11,,0,0,0,,Hai đứa cư xử lạ quá.
Dialogue: 0,0:16:10.68,0:16:11.62,Default 11,,0,0,0,,
Dialogue: 0,0:16:11.62,0:16:12.68,Default 11,,0,0,0,,Đừng!
Dialogue: 0,0:16:12.68,0:16:13.19,Default 11,,0,0,0,,Này!
Dialogue: 0,0:16:13.23,0:16:13.74,Default 11,,0,0,0,,Ơ?
Dialogue: 0,0:16:13.93,0:16:16.01,Default 11,,0,0,0,,Thôi, đừng quay nữa.
Dialogue: 0,0:16:16.01,0:16:16.60,Default 11,,0,0,0,,Hả?
Dialogue: 0,0:16:17.95,0:16:18.75,Default 11,,0,0,0,,Tại sao?
Dialogue: 0,0:16:18.75,0:16:20.40,Default 11,,0,0,0,,Bảo đừng quay thì đừng quay!
Dialogue: 0,0:16:20.67,0:16:22.47,Default 11,,0,0,0,,Khoan đã!
Dialogue: 0,0:16:22.67,0:16:25.15,Default 11,,0,0,0,,Em giận cái gì thế, Tanigawa?
Dialogue: 0,0:16:25.15,0:16:27.07,Default 11,,0,0,0,,Đ-Đâu có...
Dialogue: 0,0:16:27.29,0:16:29.07,Default 11,,0,0,0,,Em có giận gì đâu.
Dialogue: 0,0:16:29.36,0:16:32.71,Default 11,,0,0,0,,Tại chị mà ra cả đấy.
Dialogue: 0,0:16:32.71,0:16:35.44,Default 11,,0,0,0,,Tự nhiên hành động kì quặc...
Dialogue: 0,0:16:35.44,0:16:36.57,Default 11,,0,0,0,,Em nói rồi...
Dialogue: 0,0:16:36.69,0:16:38.02,Default 11,,0,0,0,,Tanigawa.
Dialogue: 0,0:16:38.39,0:16:40.88,Default 11,,0,0,0,,Khuôn mặt đang xấu hổ của em bị quay lại kìa.
Dialogue: 0,0:16:41.80,0:16:42.99,Default 11,,0,0,0,, Đừng!
Dialogue: 0,0:16:42.99,0:16:44.01,Default 11,,0,0,0,,
Dialogue: 0,0:16:43.97,0:16:45.11,Default 11,,0,0,0,,Đây rồi.
Dialogue: 0,0:16:45.11,0:16:48.81,Default 11,,0,0,0,,Mạch ý tưởng đang tuôn trào.
Dialogue: 0,0:16:54.96,0:16:56.00,Default 11,,0,0,0,,Không được đâu!
Dialogue: 0,0:16:56.00,0:16:57.56,Default 11,,0,0,0,, Không là không!
Dialogue: 0,0:17:02.34,0:17:03.75,Default 11,,0,0,0,,Chị ấy sao rồi, Kai?
Dialogue: 0,0:17:04.95,0:17:07.65,Default 11,,0,0,0,,Ngủ say lắm rồi.
Dialogue: 0,0:17:08.43,0:17:10.76,Default 11,,0,0,0,,Chị ấy sao thế nhỉ?
Dialogue: 0,0:17:10.76,0:17:14.05,Default 11,,0,0,0,,Tự nhiên tính cách thay đổi hẳn...
Dialogue: 0,0:17:14.78,0:17:18.28,Default 11,,0,0,0,,Chắc là do chưa quen với việc làm phim nên bị kiệt sức thôi.
Dialogue: 0,0:17:18.28,0:17:19.69,Default 11,,0,0,0,,Mà kể ra,
Dialogue: 0,0:17:19.93,0:17:22.20,Default 11,,0,0,0,,Không thể làm một bộ phim như thế này được.
Dialogue: 0,0:17:22.20,0:17:23.12,Default 11,,0,0,0,,Đừng lo.
Dialogue: 0,0:17:23.55,0:17:26.12,Default 11,,0,0,0,,Chỉ cần nhập tâm vào đó, Ichika sẽ làm được.
Dialogue: 0,0:17:27.14,0:17:29.09,Default 11,,0,0,0,,Chắc cậu cũng hiểu mà, Kirishima.
Dialogue: 0,0:17:29.27,0:17:30.86,Default 11,,0,0,0,,Có lẽ...
Dialogue: 0,0:17:31.19,0:17:34.24,Default 11,,0,0,0,,Lúc hai đứa học bài, em đã nói là không muốn...
Dialogue: 0,0:17:35.11,0:17:36.03,Default 11,,0,0,0,,Ơ?
Dialogue: 0,0:17:36.18,0:17:37.91,Default 11,,0,0,0,,Đã xảy ra chuyện gì?
Dialogue: 0,0:17:37.91,0:17:38.94,Default 11,,0,0,0,,Hả?
Dialogue: 0,0:17:39.36,0:17:43.43,Default 11,,0,0,0,,Tớ hỏi là đã xảy ra chuyện gì giữa cậu và chị Takatsuki!?
Dialogue: 0,0:17:43.43,0:17:47.87,Default 11,,0,0,0,,C-Có gì đâu, đêm đó hai đứa chỉ học tới khuya thôi.
Dialogue: 0,0:17:47.87,0:17:52.36,Default 11,,0,0,0,,Chị ấy dạy cậu làm mấy chuyện "ấy ấy" phải không?
Dialogue: 0,0:17:52.42,0:17:54.00,Default 11,,0,0,0,,Thế là sao?
Dialogue: 0,0:17:54.06,0:17:57.37,Default 11,,0,0,0,,Kiểu như "giao lưu và kết hợp" ấy.
Dialogue: 0,0:17:57.37,0:17:58.16,Default 11,,0,0,0,,Không!
Dialogue: 0,0:17:58.16,0:17:59.68,Default 11,,0,0,0,,Chán thế.
Dialogue: 0,0:17:59.82,0:18:00.82,Default 11,,0,0,0,,Rồi sao?
Dialogue: 0,0:18:00.82,0:18:05.99,Default 11,,0,0,0,,Đừng bảo là cậu và chị ấy ở với nhau cả tháng mà không có chuyện gì nhé?
Dialogue: 0,0:18:05.99,0:18:08.10,Default 11,,0,0,0,,Đúng thế đấy.
Dialogue: 0,0:18:10.85,0:18:12.37,Default 11,,0,0,0,,Đồ yếu sinh lí...
Dialogue: 0,0:18:12.90,0:18:14.29,Default 11,,0,0,0,,Để tớ yên.
Dialogue: 0,0:18:14.29,0:18:18.35,Default 11,,0,0,0,,Cả đám ở đây rồi thì bàn chuyện làm phim đi.
Dialogue: 0,0:18:18.44,0:18:20.36,Default 11,,0,0,0,,Tớ tán thành.
Dialogue: 0,0:18:21.30,0:18:22.69,Default 11,,0,0,0,,Sao thế, Mio?
Dialogue: 0,0:18:22.69,0:18:24.67,Default 11,,0,0,0,,Nãy giờ thấy cậu im lặng quá.
Dialogue: 0,0:18:26.14,0:18:30.12,Default 11,,0,0,0,,Không có gì hết...
Dialogue: 0,0:18:31.19,0:18:33.54,Default 11,,0,0,0,,À, tớ có nói là có gì đâu...
Dialogue: 0,0:18:33.66,0:18:35.89,Default 11,,0,0,0,,Không có gì hết!
Dialogue: 0,0:18:36.13,0:18:37.13,Default 11,,0,0,0,,Này, Mio.
Dialogue: 0,0:18:37.13,0:18:38.89,Default 11,,0,0,0,,Tetsuro, cậu làm cậu ấy tức rồi kìa!
Dialogue: 0,0:18:39.52,0:18:42.02,Default 11,,0,0,0,,Im đi! Quay lại chủ đề chính thôi!
Dialogue: 0,0:18:42.02,0:18:43.47,Default 11,,0,0,0,,Đúng rồi, quay lại thôi!
Dialogue: 0,0:18:43.47,0:18:44.06,Default 11,,0,0,0,,Hả!?
Dialogue: 0,0:18:44.24,0:18:47.47,Default 11,,0,0,0,,Tưởng tớ sẽ tin giữa cậu và chị Takatsuki không có gì ư?
Dialogue: 0,0:18:47.47,0:18:49.21,Default 11,,0,0,0,,Ta quay lại đó à?
Dialogue: 0,0:18:49.29,0:18:51.89,Default 11,,0,0,0,,À... Cậu định chơi tớ...
Dialogue: 0,0:18:51.99,0:18:53.20,Default 11,,0,0,0,,Đừng gây sự với tớ.
Dialogue: 0,0:18:53.20,0:18:55.30,Default 11,,0,0,0,,Không có gì mà!
Dialogue: 0,0:18:55.30,0:18:57.02,Default 11,,0,0,0,,Gây sự à...?
Dialogue: 0,0:18:57.87,0:18:59.84,Default 11,,0,0,0,,Ý là thế này hả!?
Dialogue: 0,0:18:59.84,0:19:01.16,Default 11,,0,0,0,,Đầu hàng!
Dialogue: 0,0:19:01.82,0:19:04.15,Default 11,,0,0,0,,Tớ đầu hàng mà!
Dialogue: 0,0:19:05.31,0:19:06.07,Default 11,,0,0,0,,Ơ!
Dialogue: 0,0:19:11.89,0:19:14.55,Default 11,,0,0,0,,Thầy u ơi! N-N-Ngực!
Dialogue: 0,0:19:14.55,0:19:18.06,Default 11,,0,0,0,,Cậu cũng đang chạm ngực của tớ mà!?
Dialogue: 0,0:19:25.81,0:19:30.20,Default 11,,0,0,0,,Fufufu... Mấy đứa làm tốt lắm. Fufufu...
Dialogue: 0,0:19:30.20,0:19:31.31,Default 11,,0,0,0,,P-Phải rồi!
Dialogue: 0,0:19:31.31,0:19:33.13,Default 11,,0,0,0,,Tớ có ý tưởng này!
Dialogue: 0,0:19:33.23,0:19:35.68,Default 11,,0,0,0,,Ý tưởng?
Dialogue: 0,0:20:57.01,0:20:57.93,Default 11,,0,0,0,,Kai?
Dialogue: 0,0:20:58.20,0:21:00.28,Default 11,,0,0,0,,Ơ?
Dialogue: 0,0:21:00.73,0:21:02.61,Default 11,,0,0,0,,Sao các cậu lại ở đây?
Dialogue: 0,0:21:03.65,0:21:04.67,Default 11,,0,0,0,,À, thật ra...
Dialogue: 0,0:21:04.67,0:21:08.15,Default 11,,0,0,0,,Bọn tớ mua pháo hoa rồi...
Dialogue: 0,0:21:10.33,0:21:11.87,Default 11,,0,0,0,,Bọn mình cùng chơi nhé?
Dialogue: 0,0:21:13.91,0:21:14.97,Default 11,,0,0,0,,Được đấy.
Dialogue: 0,0:21:17.96,0:21:20.26,Default 11,,0,0,0,,Ồ, pháo sáng đẹp nhỉ.
Dialogue: 0,0:21:20.67,0:21:22.53,Default 11,,0,0,0,,Tetsurou, thắp giùm tớ đi.
Dialogue: 0,0:21:22.64,0:21:23.43,Default 11,,0,0,0,,Đây.
Dialogue: 0,0:21:26.31,0:21:27.97,Default 11,,0,0,0,,Tecchan, nó tắt rồi.
Dialogue: 0,0:21:27.97,0:21:29.66,Default 11,,0,0,0,,À, còn đây.
Dialogue: 0,0:21:29.81,0:21:32.57,Default 11,,0,0,0,,Kai-kun, nè.
Dialogue: 0,0:21:45.71,0:21:46.85,Default 11,,0,0,0,,Nè.
Dialogue: 0,0:21:47.57,0:21:49.96,Default 11,,0,0,0,,Đã mấy năm rồi nhỉ?
Dialogue: 0,0:21:49.96,0:21:51.12,Default 11,,0,0,0,,Cẩn thận nhé.
Dialogue: 0,0:21:51.55,0:21:56.05,Default 11,,0,0,0,,Cả nhóm mới đó giờ đã được hai năm rồi...
Dialogue: 0,0:21:56.90,0:22:01.11,Default 11,,0,0,0,,Tetsurou, Kitahara, Tanigawa, chị Lemon...
Dialogue: 0,0:22:02.09,0:22:05.14,Default 11,,0,0,0,,Và... cả chị Ichika nữa.
Dialogue: 0,0:22:05.51,0:22:06.94,Default 11,,0,0,0,,Ừ.
Dialogue: 0,0:22:10.02,0:22:11.13,Default 11,,0,0,0,,Ừ nhỉ.
Dialogue: 0,0:22:13.09,0:22:14.11,Default 11,,0,0,0,,À,
Dialogue: 0,0:22:15.07,0:22:17.07,Default 11,,0,0,0,,Cả lỗ rốn của cậu nữa.
Dialogue: 0,0:22:18.14,0:22:20.08,Default 11,,0,0,0,,Quên ngay và luôn!
Dialogue: 0,0:22:21.08,0:22:23.57,Default 11,,0,0,0,,Ừ, tớ đang cố.
Dialogue: 0,0:22:31.58,0:22:33.13,Default 11,,0,0,0,,Đẹp quá.
Dialogue: 0,0:22:33.13,0:22:34.36,Default 11,,0,0,0,,Ừ.
Dialogue: 0,0:22:34.36,0:22:37.57,Default 11,,0,0,0,,Đẹp quá! Tớ cũng muốn đốt một quả.
Dialogue: 0,0:22:37.57,0:22:38.61,Default 11,,0,0,0,,Nè!
Dialogue: 0,0:22:38.61,0:22:39.69,Default 11,,0,0,0,,Tanigawa!
Dialogue: 0,0:22:39.69,0:22:41.80,Default 11,,0,0,0,,Cái đó không dùng tay cầm được đâu!
Dialogue: 0,0:22:42.53,0:22:44.17,Default 11,,0,0,0,,Nào, đưa cho tớ.
Dialogue: 0,0:22:44.44,0:22:45.80,Default 11,,0,0,0,,Này, Mio.
Dialogue: 0,0:22:45.80,0:22:46.58,Default 11,,0,0,0,,Hả?
Dialogue: 0,0:22:47.85,0:22:51.34,Default 11,,0,0,0,,Tớ sẽ thi vào đại học ở Tokyo.
Dialogue: 0,0:22:52.04,0:22:54.31,Default 11,,0,0,0,,Ừ, tớ biết mà.
Dialogue: 0,0:22:55.70,0:22:56.94,Default 11,,0,0,0,,Thế à.
Dialogue: 0,0:23:00.76,0:23:02.36,Default 11,,0,0,0,,Tớ sẽ theo cậu.
Dialogue: 0,0:23:03.34,0:23:04.85,Default 11,,0,0,0,,Được chứ?
Dialogue: 0,0:23:17.09,0:23:18.30,Default 11,,0,0,0,,Các cậu,
Dialogue: 0,0:23:20.46,0:23:23.32,Default 11,,0,0,0,,Tớ vẫn muốn làm phim.
Dialogue: 0,0:23:23.98,0:23:27.68,Default 11,,0,0,0,,Dù chỉ đơn giản như thế này, hay là một kết thúc có hậu.
Dialogue: 0,0:23:29.06,0:23:30.23,Default 11,,0,0,0,,Ừ.
Dialogue: 0,0:23:33.34,0:23:35.07,Default 11,,0,0,0,,Bọn tớ sẽ chờ.
Dialogue: 0,0:23:37.40,0:23:38.30,Default 11,,0,0,0,,Ừ.
Dialogue: 0,0:23:40.24,0:23:43.10,Default 11,,0,0,0,,Những mảnh kí ức trong trái tim chúng ta,
Dialogue: 0,0:23:44.31,0:23:45.78,Default 11,,0,0,0,,Ngày qua ngày,
Dialogue: 0,0:23:46.11,0:23:49.68,Default 11,,0,0,0,,Đang dần biến mất.
Dialogue: 0,0:23:53.91,0:23:57.16,Default 11,,0,0,0,,Điều đó thật đau đớn.
Dialogue: 0,0:23:58.68,0:23:59.66,Default 11,,0,0,0,,Nhưng,
Dialogue: 0,0:24:03.40,0:24:07.30,Default 11,,0,0,0,,Miễn là mình còn xem cuộn phim này, thì dù...
Dialogue: 0,0:24:08.97,0:24:10.32,Default 11,,0,0,0,,Khoảnh khắc đó,
Dialogue: 0,0:24:11.16,0:24:13.61,Default 11,,0,0,0,,Nếu lúc đó mình không gặp chị ấy,
Dialogue: 0,0:24:14.47,0:24:16.98,Default 11,,0,0,0,,Thì chắc chắn chúng ta,
Dialogue: 0,0:24:17.66,0:24:18.74,Default 11,,0,0,0,,Chắc chắn,
Dialogue: 0,0:24:19.58,0:24:21.64,Default 11,,0,0,0,,Đã sống một cuộc sống khác.
Dialogue: 0,0:24:24.16,0:24:25.38,Default 11,,0,0,0,,Nhưng,
Dialogue: 0,0:24:26.16,0:24:29.14,Default 11,,0,0,0,,Đó không có nghĩa là kết thúc.
Dialogue: 0,0:24:35.46,0:24:37.28,Default 11,,0,0,0,,Đó là phần tiếp theo.
Dialogue: 0,0:24:41.69,0:24:43.37,Default 11,,0,0,0,,Chúng ta sẽ đợi.
Dialogue: 0,0:24:46.41,0:24:50.23,Default 11,,0,0,0,,Để quay tiếp bộ phim... vào mùa hè đó.
Dialogue: 0,0:25:02.76,0:25:03.90,Default 11,,0,0,0,,Đó...
Dialogue: 0,0:25:05.09,0:25:06.44,Default 11,,0,0,0,,Mới là kết thúc.
Dialogue: 0,0:25:06.44,0:25:08.44,Default 11,,0,0,0,,
