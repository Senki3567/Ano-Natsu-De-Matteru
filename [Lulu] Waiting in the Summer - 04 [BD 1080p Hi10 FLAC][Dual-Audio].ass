Dialogue: 0,0:00:11.55,0:00:13.33,Default,Kaito,0,0,0,,À, ừm...
Dialogue: 0,0:00:24.22,0:00:25.34,Default,Kaito,0,0,0,,{\i1}Làm...
Dialogue: 0,0:00:25.88,0:00:27.04,Default,Ichika,0,0,0,,{\i1}Làm...
Dialogue: 0,0:00:27.69,0:00:29.15,Default,Ichika & Kaito,0,0,0,,{\i1}Làm sao đây?
Dialogue: 0,0:02:06.04,0:02:06.77,Default,Kaito,0,0,0,,{\i1}Đừng nghĩ nữa.
Dialogue: 0,0:02:08.34,0:02:10.59,Default,Kaito,0,0,0,,{\i1}Đừng nghĩ về chuyện đó nữa, Kirishima Kaito.
Dialogue: 0,0:02:11.50,0:02:14.36,Default,Kaito,0,0,0,,{\i1}Có phải mày tỏ tình với chị ấy đâu.
Dialogue: 0,0:02:15.43,0:02:18.78,Default,Kaito,0,0,0,,{\i1}Với lại chị ấy cũng đâu có nhận ra chuyện hôm đó.
Dialogue: 0,0:02:19.49,0:02:21.78,Default,Ichika,0,0,0,,Bình tĩnh nào, Ichika.
Dialogue: 0,0:02:22.14,0:02:25.67,Default,Ichika,0,0,0,,Mình lớn tuổi hơn Kaito-kun,\Nphải chín chắn lên chứ.
Dialogue: 0,0:02:26.49,0:02:28.54,Default,Ichika,0,0,0,,Cứ làm bữa sáng như mọi ngày nào.
Dialogue: 0,0:02:28.94,0:02:32.00,Default,Ichika,0,0,0,,Cố thêm một chút nữa và làm cơm trưa.
Dialogue: 0,0:02:32.58,0:02:34.71,Default,Kaito,0,0,0,,{\i1}Đúng thế, không có vấn đề gì cả.
Dialogue: 0,0:02:35.41,0:02:38.01,Default,Kaito,0,0,0,,{\i1}Chỉ là sống chung một mái nhà thôi mà.
Dialogue: 0,0:02:38.54,0:02:39.63,Default,Kaito,0,0,0,,{\i1}Chỉ có vậy thôi.
Dialogue: 0,0:02:39.63,0:02:41.59,Default,Ichika,0,0,0,,Cứ tự nhiên nào, Ichika.
Dialogue: 0,0:02:41.60,0:02:45.15,Default,Ichika,0,0,0,,Phải thật tự nhiên.\NCứ như mọi ngày thôi.
Dialogue: 0,0:02:48.62,0:02:51.38,Default,Ichika,0,0,0,,Bình tĩnh, bình tĩnh, bình tĩnh.
Dialogue: 0,0:02:51.38,0:02:55.09,Default,Ichika,0,0,0,,Mình chỉ cần cố là làm được mà. Tự tin lên nào.
Dialogue: 0,0:02:55.09,0:02:57.62,Default,Ichika,0,0,0,,Mà tự luyến như vậy có hơi kỳ không nhỉ?
Dialogue: 0,0:02:57.62,0:02:58.74,Default,Ichika,0,0,0,,Hay đúng hơn là...
Dialogue: 0,0:02:57.60,0:02:58.74,Alt,Kaito,0,0,0,,Chào buổi sáng!
Dialogue: 0,0:03:00.83,0:03:02.66,Default,Ichika,0,0,0,,C-Chào buổi sáng.
Dialogue: 0,0:03:02.66,0:03:05.18,Default,Kaito,0,0,0,,T-Trời đẹp thật nhỉ.
Dialogue: 0,0:03:05.18,0:03:06.60,Default,Ichika,0,0,0,,Phải ha...
Dialogue: 0,0:03:06.60,0:03:08.18,Default,Kaito,0,0,0,,Hôm nay sẽ nắng đẹp lắm đây.
Dialogue: 0,0:03:08.18,0:03:09.41,Default,Ichika,0,0,0,,Đúng thế nhỉ.
Dialogue: 0,0:03:11.20,0:03:13.25,Default,Kaito,0,0,0,,Gần thi học kỳ rồi nhỉ.
Dialogue: 0,0:03:14.30,0:03:15.59,Default,Ichika,0,0,0,,Đúng vậy ha.
Dialogue: 0,0:03:16.17,0:03:18.30,Default,Kaito,0,0,0,,Em học không giỏi lắm.
Dialogue: 0,0:03:20.72,0:03:20.76,Default,Ichika,0,0,0,,Ra là vậy.
Dialogue: 0,0:03:26.38,0:03:29.48,Default,Kaito,0,0,0,,Mình còn chả nhớ nổi\Nsáng nay ăn gì nữa.
Dialogue: 0,0:03:29.48,0:03:32.72,Default,Mio,0,0,0,,Chào buổi sáng, Kirishima-kun.
Dialogue: 0,0:03:32.72,0:03:34.65,Default,Kanna,0,0,0,,Hiếm khi thấy cậu đến sớm ha.
Dialogue: 0,0:03:34.65,0:03:36.61,Default,Kaito,0,0,0,,C-Cũng tùy ngày thôi.
Dialogue: 0,0:03:37.55,0:03:41.14,Default,Kaito,0,0,0,,À, Tanigawa, chuyện hôm qua tớ xin lỗi nhé.
Dialogue: 0,0:03:41.14,0:03:43.31,Default,Kaito,0,0,0,,Vì để lạc mất cậu rồi cứ thế đi về luôn.
Dialogue: 0,0:03:43.31,0:03:46.88,Default,Kanna,0,0,0,,Không đâu, tớ mới là người phải xin lỗi chứ.
Dialogue: 0,0:03:46.88,0:03:49.79,Default,Kanna,0,0,0,,Đúng hơn là lỗi của\NRemon-senpai và tụi Mio.
Dialogue: 0,0:03:50.78,0:03:53.15,Default,Mio,0,0,0,,Tớ xin lỗi cả ngày hôm qua rồi mà.
Dialogue: 0,0:03:53.15,0:03:56.12,Default,Kanna,0,0,0,,Phải rồi, nghe nè, Kaito-kun.
Dialogue: 0,0:03:56.12,0:04:02.26,Default,Kanna,0,0,0,,Hôm qua không chỉ mỗi Remon-senpai\Nmà còn cả Tetsuro và Mio theo dõi tụi mình nữa đó.
Dialogue: 0,0:04:02.26,0:04:04.09,Default,Kaito,0,0,0,,Vậy sao?
Dialogue: 0,0:04:04.09,0:04:06.56,Default,Mio,0,0,0,,Xin lỗi cậu nha, Kirishima-kun.
Dialogue: 0,0:04:06.56,0:04:07.64,Default,Kaito,0,0,0,,Không, có gì đâu.
Dialogue: 0,0:04:08.91,0:04:10.10,Default,Mio,0,0,0,,Có chuyện gì à?
Dialogue: 0,0:04:10.10,0:04:12.86,Default,Kaito,0,0,0,,C-Chuyện gì là chuyện gì chứ?
Dialogue: 0,0:04:12.86,0:04:15.37,Default,Mio,0,0,0,,Trông cậu không giống mọi ngày lắm.
Dialogue: 0,0:04:15.37,0:04:17.76,Default,Kaito,0,0,0,,T-Thế sao? Làm gì có.
Dialogue: 0,0:04:17.76,0:04:19.11,Default,Kaito,0,0,0,,Tớ hoàn toàn bình thường mà.
Dialogue: 0,0:04:23.75,0:04:26.91,Default,Remon,0,0,0,,Hôm qua cậu có tới Karuizawa nhỉ?
Dialogue: 0,0:04:26.91,0:04:29.58,Default,Ichika,0,0,0,,Hả? À, ừm...
Dialogue: 0,0:04:29.59,0:04:31.01,Default,Remon,0,0,0,,Để làm gì thế?
Dialogue: 0,0:04:31.01,0:04:32.54,Default,Ichika,0,0,0,,Tớ đi mua sắm chút đồ thôi.
Dialogue: 0,0:04:32.54,0:04:34.54,Default,Remon,0,0,0,,Kirishima-kun cũng ở đó.
Dialogue: 0,0:04:36.20,0:04:37.56,Default,Remon,0,0,0,,Ở Karuizawa ấy.
Dialogue: 0,0:04:38.57,0:04:40.24,Default,Ichika,0,0,0,,V-Vậy sao.
Dialogue: 0,0:04:40.99,0:04:44.59,Default,Remon,0,0,0,,Kirishima-kun. Kirishima-kun.
Dialogue: 0,0:04:49.60,0:04:50.89,Default,Remon,0,0,0,,Thú vị thật đấy.
Dialogue: 0,0:04:59.42,0:05:03.03,Default,Kaito,0,0,0,,Mình nghĩ chắc giờ\Nchị ấy đang bối rối lắm.
Dialogue: 0,0:05:03.03,0:05:05.61,Default,Ichika,0,0,0,,Không có chuyện đó đâu.
Dialogue: 0,0:05:07.72,0:05:11.16,Default,Ichika,0,0,0,,{\blur3}Chỉ là do đột ngột quá\Nnên mình hơi ngạc nhiên thôi.
Dialogue: 0,0:05:11.90,0:05:14.43,Default,Ichika,0,0,0,,{\blur3}Tại vì mình cũng...
Dialogue: 0,0:05:15.22,0:05:16.54,Default,Kaito,0,0,0,,{\blur3}Thật sao ạ?!
Dialogue: 0,0:05:17.51,0:05:18.38,Default,Ichika,0,0,0,,{\blur3}Thật của thật luôn!
Dialogue: 0,0:05:20.11,0:05:22.46,Default,Kaito,0,0,0,,Tuyệt quá, chúng ta đều thích nhau!
Dialogue: 0,0:05:23.03,0:05:24.73,Default,Kaito,0,0,0,,Tuyệt quá!
Dialogue: 0,0:05:24.73,0:05:27.05,Default,Tetsuro,0,0,0,,Tao không có thuộc cộng đồng nha!
Dialogue: 0,0:05:32.16,0:05:34.24,Default,Tetsuro,0,0,0,,Cái đó phải là phản ứng của tao mới đúng.
Dialogue: 0,0:05:34.24,0:05:34.73,Default,Tetsuro,0,0,0,,Nè.
Dialogue: 0,0:05:35.43,0:05:36.54,Default,Kaito,0,0,0,,Cơm trưa?
Dialogue: 0,0:05:36.54,0:05:39.57,Default,Tetsuro,0,0,0,,Hồi nãy Ichika-senpai đã nhờ tao.
Dialogue: 0,0:05:39.57,0:05:42.07,Default,Tetsuro,0,0,0,,Bảo mang tới đưa cho mày.
Dialogue: 0,0:05:42.07,0:05:43.11,Default,Kaito,0,0,0,,Chị ấy nhờ à?
Dialogue: 0,0:05:43.11,0:05:45.28,Default,Tetsuro,0,0,0,,Người ta đã cất công làm cho mày đấy.
Dialogue: 0,0:05:45.28,0:05:46.82,Default,Tetsuro,0,0,0,,Đừng có quên ở nhà chứ.
Comment: 0,0:05:49.20,0:05:50.83,Default,Kaito,0,0,0,,À, ờ.
Dialogue: 0,0:05:50.54,0:05:52.58,Default,Kaito,0,0,0,,Mày nói phải.
Dialogue: 0,0:05:55.46,0:05:57.45,Default,Kaito,0,0,0,,Này, Tetsuro.
Dialogue: 0,0:05:58.49,0:06:00.50,Default,Kaito,0,0,0,,Chỉ là ví dụ thôi nhé.
Dialogue: 1,0:06:01.22,0:06:04.71,Default,Kaito,0,0,0,,Có một cậu A nói bóng gió\Nnhư tỏ tình với cô B.
Dialogue: 0,0:06:05.62,0:06:08.68,Default,Kaito,0,0,0,,Ngay sau đó, cô B cứ thế bỏ về luôn.
Dialogue: 0,0:06:09.41,0:06:14.14,Default,Kaito,0,0,0,,Kể từ đó, thái độ của cô B\Nđối với cậu A cứ ngượng ngùng sao ấy.
Dialogue: 0,0:06:15.07,0:06:17.39,Default,Kaito,0,0,0,,Vậy cô B đang nghĩ gì?
Dialogue: 0,0:06:19.37,0:06:20.69,Default,Tetsuro,0,0,0,,Bối rối chứ gì nữa.
Dialogue: 0,0:06:21.32,0:06:22.82,Default,Kaito,0,0,0,,Biết mà.
Dialogue: 0,0:06:23.57,0:06:27.17,Default,Ichika,0,0,0,,Cô A kiểu như được cậu B\Ntỏ tình với mình.
Dialogue: 0,0:06:27.17,0:06:30.32,Default,Ichika,0,0,0,,Vì quá ngạc nhiên\Nnên cô ấy đã bỏ chạy khỏi chỗ đó.
Dialogue: 0,0:06:31.06,0:06:32.37,Default,Ichika,0,0,0,,Câu hỏi đặt ra là...
Dialogue: 0,0:06:32.37,0:06:34.20,Default,Ichika,0,0,0,,Cô A phải làm sao đây?
Dialogue: 0,0:06:34.97,0:06:36.41,Default,Remon,0,0,0,,Cô ấy nên trả lời mới phải.
Dialogue: 0,0:06:37.94,0:06:39.29,Default,Ichika,0,0,0,,Đúng vậy ha.
Dialogue: 0,0:06:39.29,0:06:43.01,Default,Remon,0,0,0,,{\pos(960,1020)}Nhân tiện thì cô A nghĩ thế nào về cậu B vậy?
